{
  "name": "nona",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "size": "size-limit"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "binaryen": "^132.0.0",
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "size-limit": "^14.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "size-limit": [
    {
      "name": "Initial JS",
      "path": "dist/assets/index-*.js",
      "limit": "97 kB",
      "gzip": true
    },
    {
      "name": "WASM engine",
      "path": "dist/assets/*.wasm",
      "limit": "167 kB",
      "gzip": true
    }
  ]
}
